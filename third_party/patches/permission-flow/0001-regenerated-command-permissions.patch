Freenpipe local change to permission-flow (applied by third_party/vendor.sh).

tauri-plugin-permission-flow's build script (tauri-plugin 2.5.3,
`Builder::build`) regenerates permissions/autogenerated/commands/*.toml on
every build, on every platform, and the regenerated files carry no
`platforms = ["macOS"]` line. Upstream committed them with that line, so a
build rewrote them in place: in cargo's git cache before W0-13, in the
repository afterwards. This patch commits the regenerated content, which is
what the plugin has always embedded, so builds leave the tree clean.

--- a/crates/tauri-plugin-permission-flow/permissions/autogenerated/commands/authorization_state.toml
+++ b/crates/tauri-plugin-permission-flow/permissions/autogenerated/commands/authorization_state.toml
@@ -6,10 +6,8 @@
 identifier = "allow-authorization-state"
 description = "Enables the authorization_state command without any pre-configured scope."
 commands.allow = ["authorization_state"]
-platforms = ["macOS"]
 
 [[permission]]
 identifier = "deny-authorization-state"
 description = "Denies the authorization_state command without any pre-configured scope."
 commands.deny = ["authorization_state"]
-platforms = ["macOS"]
--- a/crates/tauri-plugin-permission-flow/permissions/autogenerated/commands/create.toml
+++ b/crates/tauri-plugin-permission-flow/permissions/autogenerated/commands/create.toml
@@ -6,10 +6,8 @@
