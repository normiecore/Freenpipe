{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Handvel docs",
  "colors": {
    "primary": "#000000",
    "light": "#ffffff",
    "dark": "#000000"
  },
  "favicon": {
    "light": "favicon.ico",
    "dark": "favicon.ico"
  },
  "logo": "favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "documentation",
        "groups": [
          {
            "group": "get started",
            "pages": ["home", "quickstart", "getting-started", "use-cases", "architecture"]
          },
          {
            "group": "pipes",
            "pages": ["pipe-store", "pipes", "pipe-debugging", "pipe-permissions"]
          },
          {
            "group": "connect",
            "pages": ["mcp-server", "mcp-apps", "connections", "connection-reference", "cloud-archive", "privacy-data-flow", "privacy-filter", "teams"]
          },
          {
            "group": "use cases",
            "pages": ["search-screen-history", "meeting-intelligence", "meeting-transcription", "ai-memory", "for-developers"]
          },
          {
            "group": "integrations",
            "pages": ["chatgpt", "apple-intelligence", "ollama", "claude-code", "opencode", "openclaw", "cline", "continue", "gemini-cli", "copilot-cli", "obsidian", "msty"]
          },
          {
            "group": "reference",
            "pages": ["api-recipes", "cli-reference"]
          },
          {
            "group": "resources",
            "pages": ["troubleshooting", "permissions", "faq", "contributing", "docs-maintenance", "changelog"]
          }
        ]
      },
      {
        "tab": "api reference",
        "openapi": "openapi.yaml"
      }
    ]
  },
  "seo": {
    "indexHiddenPages": false
  },
  "api": {
    "playground": {
      "display": "none"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "issues",
        "href": "https://github.com/normiecore/Handvel/issues"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/normiecore/Handvel"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/normiecore/Handvel"
    }
  },
  "search": {
    "prompt": "search Handvel docs..."
  },
  "metadata": {
    "og:site_name": "Handvel docs"
  }
}
