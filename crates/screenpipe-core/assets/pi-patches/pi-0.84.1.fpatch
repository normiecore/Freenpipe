    async _checkCompaction(assistantMessage, skipAbortedCheck = true) {
        const settings = this.settingsManager.getCompactionSettings();
@@@ replace
    async _checkCompaction(assistantMessage, skipAbortedCheck = true) {
        // freenpipe-patch:sized-settings-check-v1
        const settings = fpCompaction.settingsForSession(this, this.settingsManager.getCompactionSettings(), { estimateTokens });
@@@ end

hunk sized-settings-run-v1
@@@ find
    async _runAutoCompaction(reason, willRetry) {
        const settings = this.settingsManager.getCompactionSettings();
@@@ replace
    async _runAutoCompaction(reason, willRetry) {
        // freenpipe-patch:sized-settings-run-v1
        const settings = fpCompaction.settingsForSession(this, this.settingsManager.getCompactionSettings(), { estimateTokens });
@@@ end

