# Freenpipe — local-first screen & audio memory (fork of screenpipe @ 892199f, MIT)
# https://github.com/normiecore/Freenpipe
#
# Freenpipe runtime patch for Pi 0.84.1 (context compaction and transport errors).
#
# Applied by crates/screenpipe-core/src/agents/pi_compaction.rs to the Pi packages
# installed under <data dir>/pi-agent/node_modules. The format:
#
#   target <package> <version>      the patch applies only to these releases
#   module <package> <path>         freenpipe-compaction.js is written here
#   file <package> <path> <sha256>  a file to edit and its stock SHA-256
#   hunk <id>                       an edit in the file named above, then
#   @@@ find                        the exact stock text (must occur once),
#   @@@ replace                     its replacement, which must contain the
#   @@@ end                         marker "freenpipe-patch:<id>"
#
# Lines between "@@@" lines are taken literally. Elsewhere, blank lines and
# lines starting with "#" are ignored. A file whose content matches neither its
# stock hash nor a fully patched state is left alone and the patch is skipped.
#
# The hooks only call into freenpipe-compaction.js; the behaviour lives there.

target @earendil-works/pi-coding-agent 0.84.1
target @earendil-works/pi-ai 0.84.1
module @earendil-works/pi-coding-agent dist/core/compaction/freenpipe-compaction.js

file @earendil-works/pi-coding-agent dist/core/agent-session.js 91e72d5497f665e731cbd79da6a6e826d8cae7d2ce156a7dee39f8ca205e32c8

