file @earendil-works/pi-ai dist/utils/error-body.js 3fbe4d7fdaa35ef2a65bd8d84f83317d774ad49db9403b00ef663a09ce1d454b

hunk transport-cause-helper-v1
@@@ find
export function normalizeProviderError(error) {
@@@ replace
// freenpipe-patch:transport-cause-helper-v1
// Network failures surface as generic text ("fetch failed", "terminated",
// "Connection error.") while the useful part, the socket or TLS error code,
// sits on error.cause. Append recognised codes so logs and the retry check
// can see them.
const FP_TRANSPORT_CODES = new Set(["ECONNRESET", "ECONNREFUSED", "ECONNABORTED", "ETIMEDOUT", "EPIPE", "ENOTFOUND", "EAI_AGAIN", "EHOSTUNREACH", "ENETUNREACH", "ENETDOWN", "EPROTO", "UND_ERR_SOCKET", "UND_ERR_CONNECT_TIMEOUT", "UND_ERR_HEADERS_TIMEOUT", "UND_ERR_BODY_TIMEOUT", "UND_ERR_CLOSED", "CERT_HAS_EXPIRED", "UNABLE_TO_VERIFY_LEAF_SIGNATURE", "SELF_SIGNED_CERT_IN_CHAIN", "DEPTH_ZERO_SELF_SIGNED_CERT", "ERR_TLS_CERT_ALTNAME_INVALID"]);
function fpWithTransportCause(error, message) {
    try {
        const codes = [];
        let current = error;
        for (let depth = 0; current && typeof current === "object" && depth < 6; depth++) {
            const code = current.code;
            if (typeof code === "string" && FP_TRANSPORT_CODES.has(code) && !codes.includes(code)) codes.push(code);
            current = current.cause;
        }
        const text = typeof message === "string" ? message : String(message);
        const missing = codes.filter((code) => !text.includes(code));
        return missing.length > 0 ? `${text} (${missing.join(", ")})` : text;
    }
    catch {
        return message;
    }
}
export function normalizeProviderError(error) {
@@@ end

hunk transport-cause-v1
@@@ find
        message: error.message,
        messageCarriesBody,
@@@ replace
        message: fpWithTransportCause(error, error.message), // freenpipe-patch:transport-cause-v1
        messageCarriesBody,
@@@ end
