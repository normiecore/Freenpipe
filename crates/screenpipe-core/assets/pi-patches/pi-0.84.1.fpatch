@@@ find
import { calculateContextTokens, collectEntriesForBranchSummary, compact, estimateContextTokens, estimateTokens, generateBranchSummary, prepareCompaction, shouldCompact, } from "./compaction/index.js";
@@@ replace
import { calculateContextTokens, collectEntriesForBranchSummary, compact, estimateContextTokens, estimateTokens, generateBranchSummary, prepareCompaction, shouldCompact, } from "./compaction/index.js";
import * as fpCompaction from "./compaction/freenpipe-compaction.js"; // freenpipe-patch:agent-session-import-v1
@@@ end

hunk proactive-compaction-v1
@@@ find
            const previousSnapshot = await previousPrepareNextTurnWithContext?.(turn, signal);
            const previousContext = previousSnapshot?.context ?? turn.context;
@@@ replace
            const previousSnapshot = await previousPrepareNextTurnWithContext?.(turn, signal);
            // freenpipe-patch:proactive-compaction-v1
