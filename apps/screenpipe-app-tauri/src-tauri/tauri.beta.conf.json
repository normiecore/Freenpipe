{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Handvel Beta",
  "identifier": "com.normiecore.handvel.beta",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "publisher": "normiecore",
    "category": "DeveloperTool",
    "shortDescription": "Local-first memory of your screen and audio",
    "longDescription": "Handvel records what is on your screen and what you hear and say, keeps it on your own machine, and makes it searchable by you and the AI tools you connect.",
    "copyright": "Copyright (c) 2024-2026 louis030195 (screenpipe base) and Handvel contributors. MIT License.",
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "externalBin": [
      "bun"
    ],
    "icon": [
      "icons/beta/32x32.png",
      "icons/beta/128x128.png",
      "icons/beta/128x128@2x.png",
      "icons/beta/256x256.png",
      "icons/beta/512x512.png",
      "icons/beta/1024x1024.png",
      "icons/beta/icon.icns",
      "icons/beta/icon.ico",
      "icons/screenpipe-logo-tray-failed.png",
      "icons/screenpipe-logo-tray-beta.png"
    ],
    "resources": [
      "assets/*"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/normiecore/Handvel/releases/download/prerelease/latest.json"
      ],
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "handvel-beta"
        ]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "screenpipe_main",
      "iconPath": "assets/screenpipe-logo-tray-white.png",
      "tooltip": "Handvel",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    },
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/.screenpipe/**"
        ]
      },
      "csp": null
    },
    "macOSPrivateApi": true
  }
}