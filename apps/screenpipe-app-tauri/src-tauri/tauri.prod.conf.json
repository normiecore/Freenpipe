{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freenpipe",
  "identifier": "com.normiecore.freenpipe",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "publisher": "normiecore",
    "category": "DeveloperTool",
    "shortDescription": "Local-first memory of your screen and audio",
    "longDescription": "Freenpipe records what is on your screen and what you hear and say, keeps it on your own machine, and makes it searchable by you and the AI tools you connect.",
    "copyright": "Copyright (c) 2024-2026 louis030195 (screenpipe base) and Freenpipe contributors. MIT License.",
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "externalBin": [
      "bun"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/screenpipe-logo-tray-failed.png",
      "icons/screenpipe-logo-tray-black.png"
    ],
    "resources": [
      "assets/*",
      "mlx.metallib"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "signCommand": "powershell -ExecutionPolicy Bypass -File sign-ssl.ps1 %1"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/normiecore/Freenpipe/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "freenpipe"
        ]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "screenpipe_main",
      "iconPath": "assets/screenpipe-logo-tray-white.png",
      "tooltip": "Freenpipe",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    },
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/.screenpipe/**"
        ]
      },
      "csp": null
    },
    "macOSPrivateApi": true
  }
}
